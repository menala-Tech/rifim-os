{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/portal", "destination": "/modules/portal/index.html" },
    { "source": "/smart-office", "destination": "/modules/smart-office/index.html" },
    { "source": "/smart-office/(.*)", "destination": "/modules/smart-office/$1" },
    { "source": "/hris", "destination": "/modules/hris/index.html" },
    { "source": "/hris/(.*)", "destination": "/modules/hris/$1" },
    { "source": "/crm", "destination": "/modules/crm/index.html" },
    { "source": "/crm/(.*)", "destination": "/modules/crm/$1" },
    { "source": "/finance", "destination": "/modules/finance/index.html" },
    { "source": "/finance/(.*)", "destination": "/modules/finance/$1" },
    { "source": "/sistem", "destination": "/modules/sistem/index.html" },
    { "source": "/sistem/(.*)", "destination": "/modules/sistem/$1" }
  ],
  "redirects": [
    { "source": "/raos", "destination": "https://raos-menala.vercel.app", "permanent": false },
    { "source": "/raos/(.*)", "destination": "https://raos-menala.vercel.app/$1", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
